PROFILE_DIR=.profile
CACHE_DIR=.cache
COPYRIGHT="Artur Lissin, Leibniz Institute DSMZ-German Collection of Microorganisms and Cell Cultures GmbH"

PYV=3.13
UV_DIR=.uv
UV_CACHE_DIR=.uv/cache
UV_INSTALL_DIR=.uv/bin
UV_PYTHON_BIN_DIR=.uv/python/bin
UV_TOOL_DIR=.uv/tools
UV_TOOL_BIN_DIR=.uv/tools/bin
UV_NO_MODIFY_PATH=1
UV_LINK_MODE=copy

EX_STYLE_VER=2.6
DENO_VER=v2.9.2
NODE_VER=24
COMPOSER_VER=2.9.3
COMPOSER_SHA=80012fac2cb3fbc9739d663d12460b11b6cfbdfd32415ab3d422b51ac7288fb4a1813c325de2908217f7ee3cc0d8c2dc

TEMPL_CONFIG_STRINF=configs/templates/config.json

CONFIG_WEB_FRONTEND=configs/stage/nginx_frontend.conf
CONFIG_STRINF=strinf/backend/src/configs/config.local.json
CONFIG_DEPLOY_STYLE=http://localhost/digidive_v1.zip
CONFIG_DEPLOY_ASSETS=http://localhost/assets.tar.gz
CONFIG_WEB_BACKEND=configs/stage/nginx_backend.conf

CONFIG_SHELL=configs/lint/shellcheckrc
CONFIG_PRETTIER=configs/lint/prettierrc.cjs
CONFIG_PRETTIER_IGNORE=configs/lint/prettierignore

BIN_DIR=bin
BIN_DEPLOY_FIX=bin/deploy/fix.sh
BIN_INSTALL_COMPOSER=bin/install/composer.sh
BIN_INSTALL_DENO=bin/install/deno.sh
BIN_TRAP_SH=bin/install/trap.sh
BIN_RUN_ENV_LINT=bin/lint/lint_env.sh
BIN_RUN_TESTS=bin/test/test.sh
BIN_RUN_LICENSE_LINT=bin/lint/licenses.sh
BIN_RUN_LFS_LINT=bin/lint/lfs_files.sh

EXTRA_DIR=extra
EXTRA_STYLE=extra/style
EXTRA_ASSETS=extra/straininfo/

APP=public
APP_STRINF=public/straininfo
APP_STRINF_ROOT=straininfo
APP_STRINF_PUB=public/straininfo/public

STRINF=strinf
STRINF_BACKEND_ENV=strinf/backend/.env
STRINF_FRONTEND_ENV=strinf/frontend/.env
STRINF_API_ENV=strinf/api/.env

NODE_ENV=development
BENCHMARK=false

BIN_DEPLOY=bin/build.sh
BIN_DEPLOY_REQ_NGINX=bin/deploy/req.nginx.sh
BIN_DEPLOY_ADD_CRON=bin/deploy/add_cron.sh
BIN_DEPLOY_PREP=bin/deploy/prep.sh
BIN_DEPLOY_REQ=bin/deploy/req.sh

DOCKER_ENV_DIR=/docker-build-env
DOCKER_ENV_BE=/docker-build-env/.env.backend

SERVER_WEB_CONFS_DIR=/straininfo/server/web

BACKEND_STAGE_PORT=3002
BACKEND_DEV_PORT=3001

FRONTEND_DEV_PORT=9001
FRONTEND_STAGE_PORT=9002
