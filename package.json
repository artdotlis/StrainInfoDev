{
    "name": "StrainInfo",
    "version": "2026.02.0",
    "description": "StrainInfo is a service developed to provide a resolution of microbial strain identifiers by storing culture collection numbers, their relations, and deposition data.",
    "private": true,
    "workspaces": [
        "strinf/frontend",
        "strinf/api"
    ],
    "author": {
        "name": "Artur Lissin",
        "email": "artur.lissin@dsmz.de"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git@github.com:LeibnizDSMZ/StrainInfo.git"
    },
    "keywords": [
        "straininfo",
        "typescript",
        "php",
        "fullstack"
    ],
    "dependencies": {
        "typescript": "7.0.2"
    },
    "devDependencies": {
        "@types/deno": "2.7.0",
        "@types/node": "24.12.2",
        "commitizen": "4.3.1",
        "@commitlint/cli": "20.4.1",
        "cz-conventional-changelog": "3.3.0",
        "@commitlint/config-conventional": "20.4.1",
        "husky": "9.1.7",
        "lint-staged": "16.2.7",
        "prettier": "3.8.1"
    },
    "scripts": {
        "build:api": "cd $STRINF_API && $DENO run build",
        "build:backend": "bash $BIN_BACKEND_BUNDLE",
        "build:frontend": "cd $STRINF_FRONTEND && deno run build",
        "build": "deno run build:frontend && deno run build:api && deno run build:backend",
        "serve:frontend": "cd $STRINF_FRONTEND && deno run serve",
        "serve": "bash $BIN_TRAP_SH 'bash $BIN_BACKEND_RUN_STAGE' 'deno run serve:frontend'",
        "dev:frontend": "cd $STRINF_FRONTEND && deno run dev",
        "dev": "bash $BIN_TRAP_SH 'bash $BIN_BACKEND_RUN_DEV' 'deno run dev:frontend'",
        "profile:backend": "bash $BIN_BACKEND_RUN_PROFILE",
        "profile": "deno run profile:backend",
        "lint": "lint-staged --concurrent false",
        "lint:licenses": "bash $BIN_RUN_LICENSE_LINT",
        "lint:lfs": "bash $BIN_RUN_LFS_LINT",
        "lint:api": "cd $STRINF_API && $DENO run lint",
        "lint:dev": "bash $BIN_RUN_ENV_LINT",
        "lint:backend": "cd $STRINF_BACKEND && bash ../../$BIN_BACKEND_LINT",
        "lint:frontend": "cd $STRINF_FRONTEND && deno run lint",
        "lint:shell": "shellcheck --rcfile=$CONFIG_SHELL $BIN_DIR/**/*.sh $STRINF/**/bin/*.sh",
        "lint:prettier": "prettier --config $CONFIG_PRETTIER --ignore-path $CONFIG_PRETTIER_IGNORE -c $STRINF/ --write",
        "test": "bash $BIN_TRAP_SH 'bash $BIN_BACKEND_RUN_STAGE' 'bash $BIN_RUN_TESTS'",
        "hook": "husky",
        "prepare": "husky"
    },
    "lint-staged": {
        "*": [
            "/bin/bash -c 'bash $BIN_RUN_LICENSE_LINT \"$@\"' _",
            "/bin/bash -c 'bash $BIN_RUN_LFS_LINT \"$@\"' _"
        ],
        "**/frontend/**/*.{ts,tsx}": [
            "/bin/bash -c 'cd $STRINF_FRONTEND && deno run lint:eslint --fix \"$@\"' _",
            "/bin/bash -c 'prettier --config $CONFIG_PRETTIER --ignore-path $CONFIG_PRETTIER_IGNORE --write \"$@\"' _"
        ],
        "**/frontend/**/*.{md,mdx}": [
            "/bin/bash -c 'cd $STRINF_FRONTEND && deno run lint:eslint $CONFIG_ESLINT_MDX --fix \"$@\"' _",
            "/bin/bash -c 'prettier --config $CONFIG_PRETTIER --ignore-path $CONFIG_PRETTIER_IGNORE --write \"$@\"' _"
        ],
        "*.sh": [
            "/bin/bash -c 'shellcheck --rcfile=$CONFIG_SHELL \"$@\"' _"
        ],
        "**/backend/**/src/**/*.php": [
            "/bin/bash -c 'cd $STRINF_BACKEND && bash ../../$BIN_BACKEND_LINT_STAGED \"$@\"' _"
        ],
        "!(**/frontend/**/*).{js,jsx,ts,tsx,html,css,md,mdx,json,yml,yaml}": [
            "/bin/bash -c 'prettier --config $CONFIG_PRETTIER --ignore-path $CONFIG_PRETTIER_IGNORE --write \"$@\"' _"
        ]
    },
    "config": {
        "commitizen": {
            "path": "cz-conventional-changelog"
        }
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    }
}